
# Monorepo .gitignore for Java (Spring Boot) and Angular

# === Backend (Java/Spring Boot) ===
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA
.idea
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# === Frontend (Angular) ===
diet-frontend/dist
diet-frontend/tmp
diet-frontend/out-tsc
diet-frontend/bazel-out
diet-frontend/node_modules
diet-frontend/npm-debug.log
diet-frontend/yarn-error.log
diet-frontend/.angular/cache
diet-frontend/.sass-cache/
diet-frontend/.connect.lock
diet-frontend/coverage
diet-frontend/libpeerconnection.log
diet-frontend/testem.log
diet-frontend/typings
diet-frontend/__screenshots__/

# IDEs and editors (shared)
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
.DS_Store
